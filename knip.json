{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "scripts/node/markdownlint/github-html.mjs",
    "scripts/node/build-policy-input.js",
    "scripts/node/bin/node-status.js",
    "scripts/node/bin/validate-schemas.js",
    "scripts/node/bin/visible-width.js",
    "scripts/node/bin/wrap-lines.js"
  ],
  "ignoreBinaries": ["devcontainer", "tombi", "yamllint"],
  "ignoreDependencies": ["@commitlint/cli", "nx"],
  "project": ["scripts/node/**/*.{js,mjs}", "*.config.js"],
  "treatConfigHintsAsErrors": true
}
