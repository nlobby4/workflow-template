# --------------------------------------------------
# Allowlist Docker ignore file.
#
# This file uses a deny-by-default approach so all files
# are excluded from the Docker build context unless explicitly
# allowed via exceptions.
#
# This keeps the development container build context predictable. The
# Dockerfile receives only explicitly allowed build-time inputs, while the
# complete repository is mounted later by the devcontainer runtime.
#
# Add files and paths to the Docker build context by adding exceptions.
# Keep the context focused on files that are needed by Dockerfile COPY
# instructions or build-time tooling.
#
# Add specific file:                        !/path/to/file
# Add all files in a directory:             !/path/to/directory/
# Add all files in a directory recursively: !/path/to/directory/**
#
# A pattern that does not contain a slash matches by basename
# in any directory.
# --------------------------------------------------

# Deny by default
*

# Allow directory traversal
!*/

# Dockerfile COPY inputs
!/.devcontainer/versions.env
!/.devcontainer/checksums.sha256
!/mise.lock
!/mise.toml
