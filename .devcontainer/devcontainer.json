{
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "VARIANT": "bookworm"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "github.vscode-github-actions",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-cspell-bundled-dictionaries",
        "joshbolduc.commitlint",
        "DavidAnson.vscode-markdownlint",
        "webpro.vscode-knip",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "zizmor.zizmor-vscode"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-npm-cache,target=/home/nlobby4/.npm,type=volume"
  ],
  "name": "nlobby4 Dev Container",
  "postCreateCommand": "nlobby4 repository setup && nlobby4 project setup",
  "postStartCommand": "nlobby4 doctor",
  "remoteUser": "nlobby4",
  "updateContentCommand": "npm ci --ignore-scripts --silent"
}
