{
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "github.vscode-github-actions",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-cspell-bundled-dictionaries",
        "joshbolduc.commitlint",
        "DavidAnson.vscode-markdownlint",
        "webpro.vscode-knip",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "zizmor.zizmor-vscode",
        "exiasr.hadolint",
        "tombi-toml.tombi",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": true,
      "installDockerComposeSwitch": false,
      "moby": true,
      "mobyBuildxVersion": "0.37.0",
      "version": "29.6.0"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "init": true,
  "mounts": [
    {
      "source": "workflow-template-pnpm-v10-store-${devcontainerId}",
      "target": "/home/nlobby4/.local/share/pnpm/store",
      "type": "volume"
    }
  ],
  "name": "nlobby4 Dev Container",
  "postCreateCommand": "mise trust && mise run setup",
  "postStartCommand": "bash scripts/linux/commands/repository/container-start.sh",
  "remoteEnv": {
    "NPM_CONFIG_STORE_DIR": "/home/nlobby4/.local/share/pnpm/store"
  },
  "remoteUser": "nlobby4",
  "shutdownAction": "stopContainer",
  "updateRemoteUserUID": true,
  "waitFor": "postCreateCommand"
}
