{
  "cache": {
    "cacheLocation": ".cache/general/cspell/.cspellcache"
  },
  "dictionaries": [
    "companies",
    "softwareTerms",
    "misc",
    "typescript",
    "node",
    "php",
    "go",
    "python",
    "powershell",
    "html",
    "css",
    "cpp",
    "csharp",
    "latex",
    "bash",
    "fonts",
    "filetypes",
    "npm",
    "project-brands",
    "project-domain",
    "project-people",
    "project-tools"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-brands",
      "description": "Project brand and organization names.",
      "path": "./spellcheck/brands.txt"
    },
    {
      "name": "project-domain",
      "description": "Project-specific technical terms and identifiers.",
      "path": "./spellcheck/domain.txt"
    },
    {
      "name": "project-people",
      "description": "Project usernames, maintainer names, and contributor handles.",
      "path": "./spellcheck/people.txt"
    },
    {
      "name": "project-tools",
      "description": "Project tool, extension, package, runtime, and command names.",
      "path": "./spellcheck/tools.txt"
    }
  ],
  "enableGlobDot": true,
  "files": ["**/*.md", ".git/COMMIT_EDITMSG"],
  "flagWords": [],
  "gitignoreRoot": ".",
  "ignorePaths": [
    "**/.git/{info,lfs,logs,objects,refs}/**",
    "**/.git/{index,*HEAD,*refs}",
    "**/.cache/**",
    "**/.generated/**",
    "**/.husky/_/**",
    "**/CHANGELOG.md",
    "**/coverage/**",
    "**/dist/**",
    "**/pnpm-lock.yaml",
    "**/schemas/**",
    "spellcheck/**"
  ],
  "language": "en-US",
  "readonly": true,
  "useGitignore": true,
  "version": "0.2"
}
