# --------------------------------------------------
# Generic attributes and settings for the repository.
#
# This file defines attributes for files in the repository,
# such as line ending normalization, Git LFS settings,
# and diff drivers for specific file types. It helps ensure
# consistent handling of files across different platforms.
#
# A pattern that does not contain a slash matches by basename
# in any directory.
#
# Git LFS is used to track large or binary media assets
# so that the actual file content is stored outside the main
# Git history, while the repository only tracks lightweight pointer files.
#
# Files can be ignored from GitHub source zip downloads
# by using the `export-ignore` attribute.
#
# Contributors must have the Git LFS client installed before working with
# media assets. The recommended setup path configures Git LFS and downloads
# the repository's LFS objects:
# mise run setup
#
# To configure only Git LFS without running repository setup:
# git lfs install --local
# git lfs pull
#
# For more information, see:
# https://git-lfs.com/
# https://git-scm.com/docs/gitattributes#_end_of_line_conversion
# https://github.com/gitattributes/gitattributes
# https://richienb.github.io/gitattributes-generator/
# --------------------------------------------------

# --------------------------------------------------
# Common Rules
# --------------------------------------------------

# Auto detect text files and perform LF normalization
*          text=auto

# Text files where line endings should be preserved
*.diff     -text
*.patch    -text

# Scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.bash     text eol=lf
*.fish     text eol=lf
*.ksh      text eol=lf
*.sh       text eol=lf
*.zsh      text eol=lf

# Documents
*.ansi     text eol=lf
*.bibtex   text diff=bibtex
*.doc      diff=astextplain
*.DOC      diff=astextplain
*.docx     diff=astextplain
*.DOCX     diff=astextplain
*.dot      diff=astextplain
*.DOT      diff=astextplain
*.pdf      diff=astextplain
*.PDF      diff=astextplain
*.rtf      diff=astextplain
*.RTF      diff=astextplain
*.md       text eol=lf diff=markdown
*.mdx      text eol=lf diff=markdown
*.tex      text diff=tex
*.adoc     text
*.textile  text
*.mustache text
*.csv      text eol=crlf
*.tab      text
*.tsv      text
*.txt      text
*.sql      text
*.epub     diff=astextplain
*.sha256   text eol=lf

# Graphics
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tif      binary
*.tiff     binary
*.ico      binary
*.svg      binary
*.eps      binary

# Serialization
*.json     text
*.toml     text
*.xml      text
*.yaml     text
*.yml      text

# Archives
*.7z       binary
*.bz       binary
*.bz2      binary
*.bzip2    binary
*.gz       binary
*.lz       binary
*.lzma     binary
*.rar      binary
*.tar      binary
*.taz      binary
*.tbz      binary
*.tbz2     binary
*.tgz      binary
*.tlz      binary
*.txz      binary
*.xz       binary
*.Z        binary
*.zip      binary
*.zst      binary

# Ignore files
*.*ignore  text eol=lf

# --------------------------------------------------
# Git LFS Rules
# --------------------------------------------------

# Apply Git LFS to the media directory and its subdirectories
media/** filter=lfs diff=lfs merge=lfs -text

# Exclude markdown files in the media directory and its subdirectories
media/**/*.md -filter -diff -merge text diff=markdown

# --------------------------------------------------
# Web Rules
# --------------------------------------------------

# Scripts
.husky/*          text eol=lf

# Source code
*.js              text eol=lf

# Docker
Dockerfile        text eol=lf

# RC files
*.*rc             text eol=lf

# Configs
package.json      text eol=lf
mise.lock         text eol=lf -diff
mise.toml         text eol=lf
pnpm-lock.yaml    text eol=lf -diff

# --------------------------------------------------
# Custom Rules
# --------------------------------------------------

# Exclude files from exports and source archives
# TODO: Append "export-ignore" to these lines
.gitignore             text eol=lf
.gitattributes         text eol=lf
.gitkeep               text eol=lf
.git-blame-ignore-revs text eol=lf
.mailmap               text eol=lf
.gitmessage            text eol=lf

# Repository specific files
.devcontainer/versions.env                  text eol=lf
.editorconfig                               text eol=lf
.github/CODEOWNERS                          text eol=lf
.markdownlint-cli2.jsonc                    text eol=lf
scripts/node/markdownlint/github-html.mjs   text eol=lf
AUTHORS                                     text eol=lf
LICENSE                                     text eol=lf
pnpm-workspace.yaml                         text eol=lf
