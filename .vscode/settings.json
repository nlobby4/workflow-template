{
  "[git-commit]": {
    "editor.defaultFormatter": "joshbolduc.commitlint",
    "editor.rulers": [72, 100],
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "workbench.editor.restoreViewState": false
  },
  "[json]": {
    "editor.quickSuggestions": {
      "strings": true
    }
  },
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "off",
    "cSpell.advanced.feature.useReferenceProviderRemove": "/^#+\\s/"
  },
  "cSpell.advanced.feature.useReferenceProviderWithRename": true,
  "cSpell.fixSpellingWithRenameProvider": true,
  "cSpell.useLocallyInstalledCSpellDictionaries": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.detectIndentation": false,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.rulers": [80],
  "files.associations": {
    "*.*ignore": "ignore",
    ".gitmessage": "git-commit",
    ".mailmap": "properties",
    "AUTHORS": "properties",
    "CODEOWNERS": "properties",
    "LICENSE": "plaintext",
    ".tool-versions": "properties",
    "**/.husky/*": "shellscript",
    "**/spellcheck/*.txt": "properties"
  },
  "files.autoSave": "off",
  "knip.configFilePath": "knip.json",
  "knip.requireConfig": true,
  "markdownlint.lintWorkspaceGlobs": [
    "!**/.git",
    "**/*.md",
    "!**/node_modules",
    "!**/CHANGELOG.md"
  ],
  "prettier.requireConfig": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.husky/_/**": true
  },
  "yaml.schemas": {
    "./schemas/nlobby4.schema.json": [
      ".nlobby4.yml"
    ]
  }
}
